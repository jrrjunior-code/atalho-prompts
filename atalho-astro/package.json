{
  "name": "atalho-astro",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro check && astro build && node scripts/generate-sitemap.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint src --ext .ts,.tsx,.astro",
    "format": "prettier --write src",
    "import": "node scripts/import-catalog.mjs",
    "check:catalog": "node scripts/check-catalog.mjs",
    "deploy": "npm run build && npx gh-pages -d dist",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "generate:sitemap": "node scripts/generate-sitemap.mjs"
  },
  "dependencies": {
    "astro": "^4.16.0",
    "astro-icon": "^1.1.0",
    "clsx": "^2.1.0",
    "lucide-astro": "^0.445.0",
    "@tanstack/virtual-core": "^3.8.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.0",
    "@astrojs/tailwind": "^5.1.0",
    "@playwright/test": "^1.47.0",
    "@types/node": "^22.0.0",
    "@vite-pwa/astro": "^0.4.0",
    "eslint": "^8.57.0",
    "eslint-plugin-astro": "^1.2.0",
    "gh-pages": "^6.1.0",
    "prettier": "^3.3.0",
    "prettier-plugin-astro": "^0.14.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.5.0",
    "vite-plugin-pwa": "^0.20.0",
    "workbox-window": "^7.1.0"
  },
  "engines": {
    "node": ">=18.17.0"
  }
}